# --- Required ---

# MongoDB Atlas (SRV string including the database name, e.g. .../openstock)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/openstock?retryWrites=true&w=majority

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Better Auth — your production URL (set after first deploy)
BETTER_AUTH_URL=http://localhost:3000

# Finnhub — free key from https://finnhub.io
# NOTE: NEXT_PUBLIC_ vars are inlined into the client bundle at build time
NEXT_PUBLIC_FINNHUB_API_KEY=

# Inngest Cloud — both keys from https://app.inngest.com/env/settings/keys
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Optional ---

# Email (Nodemailer via Gmail app password)
# NODEMAILER_EMAIL=
# NODEMAILER_PASSWORD=

# AI provider (default gemini; also: minimax, siray)
# GEMINI_API_KEY=
# AI_PROVIDER=gemini
# MINIMAX_API_KEY=

# Kit / ConvertKit (weekly broadcast + re-engagement emails)
# KIT_API_KEY=
# KIT_API_SECRET=
# KIT_WELCOME_FORM_ID=
